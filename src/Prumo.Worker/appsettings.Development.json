{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Storage": {
    "RootPath": "D:\\storage\\documents"
  },
  "AI": {
    "Provider": "Gemini",
    "Model": "gemini-3.5-flash-lite",
    "FallbackModel": "gemini-3.1-flash-lite",
    "RateLimit": {
      "Enabled": true,
      "MaxRequestsPerMinute": 15
    }
  }
}
